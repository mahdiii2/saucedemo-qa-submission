{
  "name": "saucedemo-playwright-assignment",
  "version": "1.0.0",
  "private": true,
  "description": "Independent SauceDemo browser tests using TypeScript and Playwright Test",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed --workers=1",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "typescript": "7.0.2"
  }
}
